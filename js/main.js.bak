                <line x1="52" y1="90" x2="52" y2="114" stroke="#000000" stroke-width="1.8"/>
                <line x1="38" y1="102" x2="66" y2="102" stroke="#000000" stroke-width="1.8"/>
                <!-- Right Yellow 4-Pane Window -->
                <rect x="124" y="90" width="28" height="24" fill="#facc15" stroke="#000000" stroke-width="2" class="og-window-glow"/>
                <line x1="138" y1="90" x2="138" y2="114" stroke="#000000" stroke-width="1.8"/>
                <line x1="124" y1="102" x2="152" y2="102" stroke="#000000" stroke-width="1.8"/>
                <!-- Red Front Door matching reference image -->
                <rect x="80" y="94" width="30" height="66" fill="#991b1b" stroke="#000000" stroke-width="2.5"/>
                <!-- Door Knob -->
                <circle cx="86" cy="128" r="2.5" fill="#facc15"/>
                <!-- Label centered cleanly above roof -->
                <text x="95" y="-12" class="og-ref-label" text-anchor="middle">House</text>
              </g>

            </svg>

          </div>
        </div>

        <!-- Live Energy Telemetry Dashboard -->
        <div class="og-telemetry-dashboard animate-fade-up">
          <div class="og-telemetry-header">
            <div class="og-telemetry-title-group">
              <span class="og-telemetry-badge">⚡ LIVE FLOW SIMULATION</span>
              <span class="og-telemetry-status" id="ogMeterDirectionArrow">EXPORT ➔ [GRID]</span>
            </div>
            <div class="og-meter-quick-stats">
              <span>Import: <strong id="ogMeterImportVal">0.0 kWh</strong></span>
              <span class="divider">|</span>
              <span>Export: <strong id="ogMeterExportVal">2.1 kWh</strong></span>
            </div>
          </div>

          <div class="og-metrics-grid">
            <!-- Metric 1: Solar Generation -->
            <div class="og-metric-card">
              <div class="og-metric-icon" style="background:#fffbeb; color:#d97706;">☀️</div>
              <div class="og-metric-info">
                <span class="og-metric-label">SOLAR GENERATION</span>
                <div class="og-metric-value text-gold" id="ogMetricSolar">5.2 <span class="og-unit">kW</span></div>
                <span class="og-metric-sub">Monocrystalline PV Array Output</span>
              </div>
            </div>

            <!-- Metric 2: Property Load -->
            <div class="og-metric-card">
              <div class="og-metric-icon" style="background:#eff6ff; color:#2563eb;">🏠</div>
              <div class="og-metric-info">
                <span class="og-metric-label">PROPERTY CONSUMPTION</span>
                <div class="og-metric-value text-blue" id="ogMetricLoad">3.1 <span class="og-unit">kW</span></div>
                <span class="og-metric-sub">Self-Consumed Clean Power</span>
              </div>
            </div>

            <!-- Metric 3: Grid Flow -->
            <div class="og-metric-card">
              <div class="og-metric-icon" style="background:#f0fdf4; color:#16a34a;">⚡</div>
              <div class="og-metric-info">
                <span class="og-metric-label" id="ogMetricGridLabel">SURPLUS TO GRID</span>
                <div class="og-metric-value text-export" id="ogMetricGrid">+2.1 <span class="og-unit">kW EXPORT</span></div>
                <span class="og-metric-sub" id="ogMetricGridSub">Banking Units with DISCOM</span>
              </div>
            </div>
          </div>

          <p class="og-disclaimer">
            *Illustrative live-flow visualization. Actual generation and export credits depend on system capacity, weather conditions, local DISCOM net-metering regulations, and consumer tariff structure.
          </p>
        </div>

        <!-- 7 Interactive Step Cards -->
        <div class="og-phases-wrapper animate-fade-up">
          <div style="text-align:center; margin-bottom:1.5rem;">
            <h3 style="color:var(--primary-900); font-size:1.4rem;">How Each Stage Operates</h3>
            <p style="color:var(--text-muted); font-size:0.9rem;">Click any stage below to highlight its role in the energy journey:</p>
          </div>

          <div class="og-phases-grid">
            <!-- Step 1 -->
            <div class="og-phase-card active" data-step="1">
              <div class="og-phase-num">01</div>
              <h4 class="og-phase-title">Sunlight</h4>
              <p class="og-phase-desc">Solar panels capture sunlight and convert it into DC electricity throughout daytime hours.</p>
            </div>

            <!-- Step 2 -->
            <div class="og-phase-card" data-step="2">
              <div class="og-phase-num">02</div>
              <h4 class="og-phase-title">Solar Generation</h4>
              <p class="og-phase-desc">High-efficiency rooftop monocrystalline panels produce DC power with zero emissions and zero moving parts.</p>
            </div>

            <!-- Step 3 -->
            <div class="og-phase-card" data-step="3">
              <div class="og-phase-num">03</div>
              <h4 class="og-phase-title">On-Grid Inverter</h4>
              <p class="og-phase-desc">Converts solar DC electricity into usable 230V/415V synchronized AC power for all appliances.</p>
            </div>

            <!-- Step 4 -->
            <div class="og-phase-card" data-step="4">
              <div class="og-phase-num">04</div>
              <h4 class="og-phase-title">Power Your Property</h4>
              <p class="og-phase-desc">Solar electricity is used directly on-site to power your home or business, eliminating daytime grid bills.</p>
            </div>

            <!-- Step 5 -->
            <div class="og-phase-card" data-step="5">
              <div class="og-phase-num">05</div>
              <h4 class="og-phase-title">Excess Solar</h4>
              <p class="og-phase-desc">When generation exceeds on-site consumption, excess electricity can flow to the grid where applicable.</p>
            </div>

            <!-- Step 6 -->
            <div class="og-phase-card" data-step="6">
              <div class="og-phase-num">06</div>
              <h4 class="og-phase-title">Net Meter</h4>
              <p class="og-phase-desc">The smart bi-directional meter records electricity exchanged with the grid with high accuracy.</p>
            </div>

            <!-- Step 7 -->
            <div class="og-phase-card" data-step="7">
              <div class="og-phase-num">07</div>
              <h4 class="og-phase-title">Grid Connection</h4>
              <p class="og-phase-desc">Your property remains safely connected to the electricity grid for uninterrupted 24x7 power at night.</p>
            </div>
          </div>
        </div>

        <!-- Smarter Energy Results & CTA Strip -->
        <div class="og-results-strip animate-fade-up">

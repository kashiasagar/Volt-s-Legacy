                  <circle cx="78" cy="75" r="1.2"/>
                  <circle cx="89" cy="79" r="1.2"/>
                  <circle cx="100" cy="84" r="1.2"/>
                  <!-- Row 5 vertices -->
                  <circle cx="54" cy="84" r="1.2"/>
                  <circle cx="65" cy="89" r="1.2"/>
                  <circle cx="76" cy="93" r="1.2"/>
                  <circle cx="87" cy="98" r="1.2"/>
                  <!-- Row 6 vertices -->

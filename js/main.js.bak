// 7.5. SIGNATURE ON-GRID SIMULATION SECTION BUILDER
function renderOnGridSection() {
  return `
    <section class="on-grid-simulator-section" id="on-grid">
      <div class="container">
        
        <!-- Section Header -->
        <div class="section-header animate-fade-up" style="text-align:center; max-width:850px; margin:0 auto 2.5rem auto;">
          <div style="display:flex; justify-content:center; margin-bottom:1rem;">
            <span class="section-tag section-tag-gold">HOW ON-GRID SOLAR WORKS</span>
          </div>
          <h2 class="section-title" style="font-size:clamp(2rem, 4.2vw, 2.85rem); margin-bottom:0.75rem;">
            Sunlight In. Clean Energy Out.
          </h2>
        </div>

        <!-- Interactive Day/Night Control Bar -->
        <div class="og-control-bar animate-fade-up">
          <div class="og-mode-toggle-group">
            <button type="button" class="og-mode-btn active" id="ogModeDayBtn" aria-label="Switch to daytime solar generation mode">
              <span class="mode-icon">☀️</span> DAYTIME (Solar Export)
            </button>
          </div>
          <div class="og-status-pill status-export" id="ogStatusPill">
            <span class="og-live-dot green"></span> ☀️ DAYTIME: SOLAR GENERATING & EXPORTING SURPLUS
          </div>
        </div>

        <!-- Fixed Technical Diagram Canvas (No Component Movement) -->
        <div class="og-stage-wrapper animate-fade-up">
          <div class="og-simulation-stage stage-day" id="ogSimulationStage">
            
            <!-- SVG Energy Ecosystem Diagram matching reference image -->
            <svg class="og-svg-canvas" viewBox="0 0 1020 680" fill="none" xmlns="http://www.w3.org/2000/svg">
              <defs>
                <!-- Gradients & Filters -->
                <linearGradient id="ogSunGrad" x1="0%" y1="0%" x2="100%" y2="100%">
                  <stop offset="0%" stop-color="#fffbeb"/>
                  <stop offset="30%" stop-color="#fbbf24"/>
                  <stop offset="70%" stop-color="#f59e0b"/>
                  <stop offset="100%" stop-color="#ea580c"/>
                </linearGradient>
                <linearGradient id="ogSunBeamGrad" x1="0%" y1="0%" x2="100%" y2="100%">
                  <stop offset="0%" stop-color="#fef08a" stop-opacity="0.85"/>
                  <stop offset="50%" stop-color="#fef08a" stop-opacity="0.45"/>
                  <stop offset="100%" stop-color="#fef08a" stop-opacity="0.05"/>
                </linearGradient>
                <linearGradient id="ogMoonGrad" x1="0%" y1="0%" x2="100%" y2="100%">
                  <stop offset="0%" stop-color="#ffffff"/>
                  <stop offset="100%" stop-color="#94a3b8"/>
                </linearGradient>
                <!-- Realistic Aluminum Frame Gradient -->
                <linearGradient id="ogFrameGrad" x1="0%" y1="0%" x2="100%" y2="100%">
                  <stop offset="0%" stop-color="#f8fafc"/>
                  <stop offset="50%" stop-color="#cbd5e1"/>
                  <stop offset="100%" stop-color="#94a3b8"/>
                </linearGradient>
                <!-- Authentic Monocrystalline Solar Cell Silicon Gradient -->
                <linearGradient id="ogSiliconGrad" x1="0%" y1="0%" x2="100%" y2="100%">
                  <stop offset="0%" stop-color="#0f2b5c"/>
                  <stop offset="35%" stop-color="#1e40af"/>
                  <stop offset="70%" stop-color="#1d4ed8"/>
                  <stop offset="100%" stop-color="#0c234a"/>
                </linearGradient>
                <!-- Tempered Glass Glare Reflection -->
                <linearGradient id="ogGlassGleam" x1="0%" y1="0%" x2="100%" y2="100%">
                  <stop offset="0%" stop-color="#ffffff" stop-opacity="0.6"/>
                  <stop offset="40%" stop-color="#93c5fd" stop-opacity="0.15"/>
                  <stop offset="100%" stop-color="#ffffff" stop-opacity="0"/>
                </linearGradient>
                <filter id="ogGlowGold" x="-30%" y="-30%" width="160%" height="160%">
                  <feGaussianBlur stdDeviation="6" result="blur"/>
                  <feComposite in="SourceGraphic" in2="blur" operator="over"/>
                </filter>
                <!-- Red Arrow Markers -->
                <marker id="ogArrowRight" markerWidth="9" markerHeight="9" refX="6" refY="4.5" orient="auto">
                  <path d="M 0 1 L 7 4.5 L 0 8 Z" fill="#ef4444"/>
                </marker>
                <marker id="ogArrowUp" markerWidth="9" markerHeight="9" refX="4.5" refY="6" orient="auto">
                  <path d="M 1 7 L 4.5 0 L 8 7 Z" fill="#ef4444"/>
                </marker>
                <marker id="ogArrowDown" markerWidth="9" markerHeight="9" refX="4.5" refY="3" orient="auto">
                  <path d="M 1 0 L 4.5 7 L 8 0 Z" fill="#ef4444"/>
                </marker>
                <marker id="ogArrowBlue" markerWidth="9" markerHeight="9" refX="6" refY="4.5" orient="auto">
                  <path d="M 0 1 L 7 4.5 L 0 8 Z" fill="#38bdf8"/>
                </marker>
              </defs>

              <!-- ================= 1. SUNLIGHT BEAM ================= -->
              <g class="og-sun-beam-group">
                <!-- Conical yellow sunlight beam spreading from sun to solar panel -->
                <polygon points="110,105 250,199 307,220 204,327 151,304" fill="url(#ogSunBeamGrad)" class="og-sunlight-cone"/>
              </g>

              <!-- ================= 2. RED WIRING CABLES & ARROWS ================= -->
              <!-- Main static red cables -->
              <!-- a) Panel to Inverter (Down then Right) -->
              <path class="og-conduit og-cable-dc" data-step="2" d="M 204 327 L 204 470 L 350 470" stroke="#ef4444" stroke-width="4.5" fill="none" stroke-linejoin="round" stroke-linecap="round"/>
              <line x1="250" y1="470" x2="295" y2="470" stroke="#ef4444" stroke-width="4.5" marker-end="url(#ogArrowRight)"/>

              <!-- b) Inverter to T-Junction (Right) -->
              <path class="og-conduit og-cable-inv" data-step="3" d="M 440 470 L 510 470" stroke="#ef4444" stroke-width="4.5" fill="none" stroke-linecap="round"/>
              <line x1="465" y1="470" x2="495" y2="470" stroke="#ef4444" stroke-width="4.5" marker-end="url(#ogArrowRight)"/>

              <!-- c) Vertical T-Junction Bus Line -->
              <line x1="510" y1="310" x2="510" y2="600" stroke="#ef4444" stroke-width="4.5" stroke-linecap="round"/>
              <circle cx="510" cy="470" r="5" fill="#ef4444"/>

              <!-- d) Junction to Net-Meter (Up & Right) -->
              <path class="og-conduit og-cable-meter" data-step="6" d="M 510 470 L 510 310 L 590 310" stroke="#ef4444" stroke-width="4.5" fill="none" stroke-linejoin="round" stroke-linecap="round"/>
              <!-- Upward arrow on vertical branch -->
              <g class="og-arrow-up-group">
                <line x1="510" y1="420" x2="510" y2="375" stroke="#ef4444" stroke-width="4.5" marker-end="url(#ogArrowUp)"/>
              </g>
              <line x1="535" y1="310" x2="570" y2="310" stroke="#ef4444" stroke-width="4.5" marker-end="url(#ogArrowRight)"/>

              <!-- e) Junction to House (Down & Right) -->
              <path class="og-conduit og-cable-house" data-step="4" d="M 510 470 L 510 600 L 660 600" stroke="#ef4444" stroke-width="4.5" fill="none" stroke-linejoin="round" stroke-linecap="round"/>
              <!-- Downward arrow on vertical branch -->
              <line x1="510" y1="520" x2="510" y2="565" stroke="#ef4444" stroke-width="4.5" marker-end="url(#ogArrowDown)"/>
              <line x1="570" y1="600" x2="625" y2="600" stroke="#ef4444" stroke-width="4.5" marker-end="url(#ogArrowRight)"/>

              <!-- f) Net-Meter to Grid (Up & Right) -->
              <path class="og-conduit og-cable-grid" data-step="7" d="M 635 260 L 635 190 L 760 190" stroke="#ef4444" stroke-width="4.5" fill="none" stroke-linejoin="round" stroke-linecap="round"/>
              <line x1="680" y1="190" x2="735" y2="190" stroke="#ef4444" stroke-width="4.5" marker-end="url(#ogArrowRight)"/>

              <!-- ================= 3. ANIMATED ELECTRICITY PARTICLE TRACKS ================= -->
              <!-- Panel to Inverter Particles -->
              <path class="og-particle-track og-track-panel-inv" d="M 204 327 L 204 470 L 350 470"/>
              
              <!-- Inverter to Junction Particles -->
              <path class="og-particle-track og-track-inv-junc" d="M 440 470 L 510 470"/>

              <!-- Junction to House Load Particles -->
              <path class="og-particle-track og-track-junc-house" d="M 510 470 L 510 600 L 660 600"/>

              <!-- Junction to Net Meter Particles (Bidirectional) -->
              <path class="og-particle-track og-track-junc-meter" d="M 510 470 L 510 310 L 590 310"/>

              <!-- Net Meter to Grid Particles (Bidirectional) -->
              <path class="og-particle-track og-track-meter-grid" d="M 635 260 L 635 190 L 760 190"/>

              <!-- Grid 3-Phase Transmission Power Line Energy Flow Particles (Below 3 Lines) -->
              <path class="og-particle-track og-track-grid-l1" d="M 860 188 Q 920 195 1000 180"/>
              <path class="og-particle-track og-track-grid-l2" d="M 868 228 Q 930 235 1000 218"/>
              <path class="og-particle-track og-track-grid-l3" d="M 860 268 Q 930 275 1000 258"/>


              <!-- ================= 4. FIXED VISUAL NODES (STATIONARY) ================= -->

              <!-- NODE 1: SUN (Top-Left) -->
              <g class="og-diagram-node node-sun" data-step="1" transform="translate(40, 35)" tabindex="0" role="button" aria-label="1. Sunlight: Solar Irradiance">
                <!-- Hover/Active Halo for Sun -->
                <rect class="og-node-halo" x="6" y="6" width="128" height="128" rx="16" fill="rgba(245, 158, 11, 0.08)"/>
                <!-- Radiant Solar Glow -->
                <circle cx="70" cy="70" r="55" fill="rgba(245, 158, 11, 0.18)"/>
                <!-- Sun Day Visual -->
                <g class="og-sun-element">
                  <circle cx="70" cy="70" r="38" fill="url(#ogSunGrad)" filter="url(#ogGlowGold)"/>
                  <!-- Radiant Sun Rays -->
                  <g class="og-sun-rays" stroke="#f59e0b" stroke-width="3.5" stroke-linecap="round">
                    <line x1="70" y1="18" x2="70" y2="4"/>
                    <line x1="70" y1="122" x2="70" y2="136"/>
                    <line x1="18" y1="70" x2="4" y2="70"/>
                    <line x1="122" y1="70" x2="136" y2="70"/>
                    <line x1="33" y1="33" x2="22" y2="22"/>
                    <line x1="107" y1="107" x2="118" y2="118"/>
                    <line x1="33" y1="107" x2="22" y2="118"/>
                    <line x1="107" y1="33" x2="118" y2="22"/>
                    <!-- Additional outer radiant star rays -->
                    <line x1="70" y1="24" x2="70" y2="10" stroke="#fbbf24" stroke-width="2"/>
                    <line x1="70" y1="116" x2="70" y2="130" stroke="#fbbf24" stroke-width="2"/>
                    <line x1="24" y1="70" x2="10" y2="70" stroke="#fbbf24" stroke-width="2"/>
                    <line x1="116" y1="70" x2="130" y2="70" stroke="#fbbf24" stroke-width="2"/>
                  </g>
                </g>
                <!-- Moon Night Visual -->
                <g class="og-moon-element" style="display:none;">
                  <circle cx="70" cy="70" r="34" fill="#1e293b"/>
                  <path d="M 70 36 A 34 34 0 0 0 98 88 A 34 34 0 1 1 70 36 Z" fill="url(#ogMoonGrad)"/>
                  <circle cx="45" cy="50" r="2.5" fill="#ffffff" opacity="0.9"/>
                  <circle cx="95" cy="40" r="2" fill="#ffffff" opacity="0.7"/>
                </g>
              </g>

              <!-- NODE 2: SOLAR PANEL (Upper-Left Tilted Grid - High-Fidelity Photorealistic PV Module) -->
              <g class="og-diagram-node node-panel" data-step="2" transform="translate(145, 185)" tabindex="0" role="button" aria-label="2. Solar Panel: DC Generation">
                <!-- Halo tightly wraps ONLY the Solar Panel image -->
                <rect class="og-node-halo" x="-8" y="0" width="184" height="162" rx="12" fill="rgba(37, 99, 235, 0.08)"/>
                
                <!-- Mounting Bracket / Grounding Rail Behind Panel -->
                <polygon points="75,85 110,45 115,55 80,95" fill="#1e293b"/>
                <line x1="80" y1="95" x2="135" y2="45" stroke="#334155" stroke-width="3" stroke-linecap="round"/>

                <!-- 3D Outer Aluminum Frame Extrusion (Depth Edges) -->
                <polygon points="0,120 62,148 62,154 0,126" fill="#64748b"/>
                <polygon points="62,148 168,32 168,38 62,154" fill="#475569"/>

                <!-- Top Face Anodized Aluminum Outer Bezel -->
                <polygon points="102,8 168,32 62,148 0,120" fill="url(#ogFrameGrad)" stroke="#cbd5e1" stroke-width="1.5"/>

                <!-- Inner Frame Shadow Recess -->
                <polygon points="104,12 164,34 60,144 4,118" fill="#0f172a"/>

                <!-- Monocrystalline Silicon Solar Cell Bed in 3D Perspective -->
                <polygon points="105,14 162,35 59,142 6,119" fill="url(#ogSiliconGrad)"/>

                <!-- Fine Silver Conduction Busbars (3 per cell column) -->
                <g stroke="#93c5fd" stroke-width="0.7" opacity="0.65">
                  <!-- Col 1 busbars -->
                  <line x1="109" y1="15" x2="10" y2="120"/>
                  <line x1="113" y1="17" x2="14" y2="122"/>
                  <!-- Col 2 busbars -->
                  <line x1="120" y1="19" x2="20" y2="125"/>
                  <line x1="124" y1="21" x2="24" y2="127"/>
                  <!-- Col 3 busbars -->
                  <line x1="132" y1="24" x2="31" y2="130"/>
                  <line x1="136" y1="25" x2="35" y2="132"/>
                  <!-- Col 4 busbars -->
                  <line x1="143" y1="28" x2="41" y2="134"/>
                  <line x1="147" y1="29" x2="45" y2="136"/>
                  <!-- Col 5 busbars -->
                  <line x1="154" y1="32" x2="52" y2="139"/>
                  <line x1="158" y1="33" x2="56" y2="141"/>
                </g>

                <!-- Primary Inter-Cell Grid Division Lines -->
                <g stroke="#ffffff" stroke-width="1.1" opacity="0.85">
                  <!-- Vertical Column Dividing Lines -->
                  <line x1="116" y1="18" x2="17" y2="124"/>
                  <line x1="128" y1="22" x2="27" y2="128"/>
                  <line x1="139" y1="27" x2="38" y2="133"/>
                  <line x1="151" y1="31" x2="48" y2="137"/>

                  <!-- Horizontal Row Dividing Lines -->
                  <line x1="93" y1="27" x2="149" y2="48"/>
                  <line x1="80" y1="40" x2="136" y2="62"/>
                  <line x1="68" y1="53" x2="123" y2="75"/>
                  <line x1="56" y1="66" x2="110" y2="88"/>
                  <line x1="43" y1="80" x2="98" y2="102"/>
                  <line x1="31" y1="93" x2="85" y2="115"/>
                  <line x1="18" y1="106" x2="72" y2="129"/>
                </g>

                <!-- Mono PERC Cell Corner Chamfer Diamond Dots (Authentic Cell Intersections) -->
                <g fill="#ffffff" opacity="0.9">

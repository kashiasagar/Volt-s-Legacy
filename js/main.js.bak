            </div>
            <div class="offering-card-body">
              <div class="offering-header">
                <span class="offering-num">2. Housing Societies</span>
                <div class="offering-icon">${SVG_ICONS.building}</div>
              </div>
              <h3 class="offering-title">Housing Societies (RWAs)</h3>

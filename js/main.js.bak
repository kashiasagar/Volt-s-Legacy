                </div>
              </div>
              <p style="color:#cbd5e1; font-size:0.95rem; line-height:1.6; margin-bottom:1.25rem;">
                <strong>Shop No. 40, 150 Feet Rd</strong><br>
                Behind Sai Shrushti Residency, Man Sarovar Society,<br>
                Godadara Gam, Godadara, Surat, Devadh, Gujarat 395010
              </p>
              
              <div style="display:flex; gap:0.75rem; flex-wrap:wrap;">
                <a href="https://maps.google.com/?q=Shop+No.+40,+150+Feet+Rd,+Behind+Sai+Shrushti+Residency,+Man+Sarovar+Society,+Godadara+Gam,+Godadara,+Surat,+Devadh,+Gujarat+395010" target="_blank" rel="noopener noreferrer" class="btn btn-primary btn-sm" style="flex:1;">
                  ${SVG_ICONS.mapPin} Open in Google Maps
                </a>
                <a href="tel:+919998765059" class="btn btn-secondary btn-sm">
                  ${SVG_ICONS.phone} +91 99987 65059
                </a>
              </div>
            </div>

            <!-- Map Iframe Wrapper -->
            <div style="border-radius:16px; overflow:hidden; border:1px solid #e2e8f0; height:320px; box-shadow:var(--shadow-md); background:#e2e8f0;">
              <iframe 
                title="VOLT'S LEGACY SOLAR Location Map"
                src="https://maps.google.com/maps?q=Shop+No.+40,+150+Feet+Rd,+Behind+Sai+Shrushti+Residency,+Man+Sarovar+Society,+Godadara+Gam,+Godadara,+Surat,+Gujarat+395010&t=&z=15&ie=UTF8&iwloc=&output=embed" 
                width="100%" 
                height="100%" 
                style="border:0;" 
                allowfullscreen="" 
                loading="lazy" 
                referrerpolicy="no-referrer-when-downgrade">
              </iframe>
            </div>

          </div>
        </div>

      </div>
    </section>
  `;
}

// --------------------------------------------------------------------------
// GLOBAL WINDOW METHODS
// --------------------------------------------------------------------------

// Filter projects in gallery
window.filterProjects = function(category, btnElement) {
  document.querySelectorAll('.filter-btn').forEach(btn => btn.classList.remove('active'));
  if (btnElement) btnElement.classList.add('active');

  const cards = document.querySelectorAll('.project-card');
  cards.forEach(card => {
    if (category === 'all' || card.getAttribute('data-cat') === category) {
      card.style.display = 'flex';
    } else {
      card.style.display = 'none';
    }
  });
};

// View project modal details
window.viewProjectDetails = function(projectId) {
  const project = PROJECTS_DATA.find(p => p.id === projectId);
  if (!project || !window.appModal) return;

  const content = `
    <div>
      <div style="height: 240px; border-radius: 12px; overflow: hidden; margin-bottom: 1.5rem; background:#071530;">
        <img src="${project.image}" alt="${project.name}" style="width:100%; height:100%; object-fit:cover;">
      </div>
      <div style="display:flex; gap:0.5rem; margin-bottom:0.75rem;">
        <span class="section-tag" style="margin-bottom:0;">${project.systemType}</span>
        <span class="section-tag section-tag-gold" style="margin-bottom:0;">Capacity: ${project.capacity}</span>
      </div>
      <h3 style="font-size: 1.5rem; color: #071530; margin-bottom: 0.5rem;">${project.name}</h3>
      <div style="display:flex; align-items:center; gap:0.4rem; color:#64748b; font-size:0.9rem; margin-bottom:1rem;">
        ${SVG_ICONS.mapPin} ${project.location}
      </div>
      <p style="color:#475569; line-height:1.6; margin-bottom:1.5rem;">
        ${project.description}
      </p>
      <div style="background:#f8fafc; border:1px solid #e2e8f0; border-radius:10px; padding:1rem; margin-bottom:1.5rem;">
        <h4 style="font-size:0.95rem; margin-bottom:0.5rem; color:#071530;">Engineering Highlights</h4>
        <ul style="list-style:none; display:flex; flex-direction:column; gap:0.4rem; font-size:0.875rem; color:#475569;">
          <li>✓ Tier-1 High-Efficiency Bifacial Solar Modules</li>
          <li>✓ Hot-Dip Galvanized C-Section Mounting Structure</li>
          <li>✓ Smart Discom Net-Metering Export Protection</li>
          <li>✓ Real-Time IoT Cloud Generation Telemetry</li>
        </ul>
      </div>
      <a href="/quotation" class="btn btn-solar" style="width:100%;" onclick="window.appModal.close();">
        Get Quotation For Similar Project ${SVG_ICONS.arrowRight}
      </a>
    </div>
  `;

  window.appModal.open(content);
};

